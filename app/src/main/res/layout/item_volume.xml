<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/volIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_card_soft"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_sd"
        app:tint="@color/fs_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/volName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fs_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/volSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fs_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
